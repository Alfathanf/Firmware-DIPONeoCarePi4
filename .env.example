BACKEND_BASE_URL=https://diponeocare.up.railway.app/
FIRMWARE_VERSION=1.0.0
IDENTITY_FILE=./data/device_identity.json
REQUEST_TIMEOUT_SECONDS=10
REGISTRATION_RETRY_SECONDS=20
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_RETRY_SECONDS=5
HEARTBEAT_TIMEOUT_SECONDS=5
FRAME_CAPTURE_INTERVAL_SECONDS=1
FRAME_UPLOAD_TIMEOUT_SECONDS=5
FRAME_UPLOAD_RETRY_SECONDS=5
FRAME_QUEUE_MAX_SIZE=1
FRAME_IMAGE_FORMAT=jpeg
FRAME_IMAGE_QUALITY=85
FRAME_IMAGE_WIDTH=640
FRAME_IMAGE_HEIGHT=480
AUDIO_DEVICE=plughw:3,0
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_BIT_DEPTH=16
AUDIO_RECORD_DURATION_SECONDS=5
AUDIO_CAPTURE_INTERVAL_SECONDS=5
AUDIO_QUEUE_MAX_SIZE=3
AUDIO_UPLOAD_TIMEOUT_SECONDS=5
AUDIO_UPLOAD_RETRY_SECONDS=5
AUDIO_STORAGE_DIR=./data/audio
